{
  "java.configuration.updateBuildConfiguration": "interactive",
  "java.server.launchMode": "LightWeight",
  "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xms64m -Xmx512m -Xlog:disable",
  "java.jdt.ls.mavenProjectCacheSize": 5,
  "java.autobuild.enabled": false,
  "java.import.gradle.enabled": false,
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/frontend/**",
    "**/mobile/**",
    "**/backups/**",
    "**/.m2/**",
    "**/.maven-user/**",
    "**/.worktrees/**",
    "**/archivos de texto/**"
  ],
  "java.project.resourceFilters": [
    "node_modules",
    "\\.git",
    "target",
    "build",
    "\\.dart_tool",
    "\\.gradle",
    "backups",
    "archivos de texto",
    "\\.runtime"
  ],
  "java.gradle.buildServer.enabled": "off",
  "gradle.autoDetect": "off",
  "typescript.tsserver.maxTsServerMemory": 768,
  "typescript.disableAutomaticTypeAcquisition": true,
  "npm.autoDetect": "off",
  "task.allowAutomaticTasks": "off",
  "git.autofetch": false,
  "appmod.enableMcpServer": false,
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/.runtime/**": true,
    "**/backups/**": true,
    "**/.angular/**": true,
    "**/.m2/**": true,
    "**/.maven-user/**": true,
    "**/.worktrees/**": true,
    "**/.tools/**": true,
    "**/archivos de texto/**": true,
    "**/backend/target/**": true,
    "**/frontend/node_modules/**": true,
    "**/frontend/dist/**": true,
    "**/frontend/.npm-cache/**": true,
    "**/frontend/coverage/**": true,
    "**/mobile/.dart_tool/**": true,
    "**/mobile/build/**": true,
    "**/mobile/android/.gradle/**": true
  },
  "search.exclude": {
    "**/.runtime/**": true,
    "**/backups/**": true,
    "**/.angular/**": true,
    "**/.m2/**": true,
    "**/.maven-user/**": true,
    "**/.worktrees/**": true,
    "**/.tools/**": true,
    "**/backend/target/**": true,
    "**/frontend/node_modules/**": true,
    "**/frontend/dist/**": true,
    "**/frontend/.npm-cache/**": true,
    "**/frontend/coverage/**": true,
    "**/mobile/.dart_tool/**": true,
    "**/mobile/build/**": true,
    "**/mobile/android/.gradle/**": true,
    "frontend/node_modules": true,
    "backend/target": true,
    "frontend/dist": true,
    "**/.angular": true,
    "backend/.m2": true,
    "backend/.maven-user": true,
    "backend/.maven-user-home": true,
    "frontend/.npm-cache": true,
    "frontend/coverage": true,
    "mobile/.dart_tool": true,
    "mobile/build": true,
    "mobile/android/.gradle": true,
    ".runtime": true,
    ".tools": true,
    "logs": true,
    "**/*.log": true,
    "archivos de texto/codigo_backend.txt": true,
    "archivos de texto/codigo_front.txt": true,
    "archivos de texto/codigo_persistencia_postgresql.txt": true,
    "archivos de texto/c?digo_extra.txt": true,
    "estructura.txt": true
  },
  "files.exclude": {
    "frontend/node_modules": true,
    "backend/target": true,
    "frontend/dist": true,
    "**/.angular": true,
    "backend/.m2": true,
    "backend/.maven-user": true,
    "backend/.maven-user-home": true,
    "frontend/.npm-cache": true,
    "frontend/coverage": true,
    "mobile/.dart_tool": true,
    "mobile/build": true,
    "mobile/android/.gradle": true,
    ".runtime": true,
    ".tools": true,
    "logs": true,
    "**/*.log": true,
    "archivos de texto/codigo_backend.txt": true,
    "archivos de texto/codigo_front.txt": true,
    "archivos de texto/codigo_persistencia_postgresql.txt": true,
    "archivos de texto/c?digo_extra.txt": true,
    "estructura.txt": true
  }
}
