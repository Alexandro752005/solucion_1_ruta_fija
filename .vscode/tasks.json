{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ruta Fija: crear configuracion nativa local (F1.1A)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\Initialize-RutaFijaNativeConfig.ps1"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Ruta Fija: validar entorno nativo (F1.1A)",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/c", "${workspaceFolder}\\iniciar_ruta_fija.bat"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Ruta Fija: finalizar fase nativa actual",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/c", "${workspaceFolder}\\finalizar_ruta_fija.bat"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
