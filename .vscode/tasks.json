{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ruta Fija: crear configuracion nativa local (F1.1A)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\Initialize-RutaFijaNativeConfig.ps1"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Ruta Fija: crear roles y base de pruebas (F1.2)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\Initialize-RutaFijaPostgresqlRoles.ps1"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Ruta Fija: aplicar Flyway controlado (F1.3)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\Invoke-RutaFijaFlywayF13.ps1"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Ruta Fija: otorgar DML de aplicacion (F1.3)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\Grant-RutaFijaApplicationPrivilegesF13.ps1"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Ruta Fija: auditar esquema nativo (F1.3)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\Test-RutaFijaMigratedSchemaF13.ps1"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Ruta Fija: iniciar nativo (F1.1B)",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/c", "${workspaceFolder}\\iniciar_ruta_fija.bat"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Ruta Fija: validar runtime nativo (F1.1B)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\Invoke-RutaFijaNativeRuntime.ps1",
        "-Action",
        "Test"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Ruta Fija: finalizar nativo (F1.1B)",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/c", "${workspaceFolder}\\finalizar_ruta_fija.bat"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
