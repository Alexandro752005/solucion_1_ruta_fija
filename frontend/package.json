{
  "name": "ruta-fija-crm",
  "version": "0.1.0",
  "private": true,
  "description": "CRM web administrativo de Ruta Fija",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --port 4300",
    "build": "ng build",
    "build:development": "ng build --configuration development",
    "test": "ng test --watch=false",
    "test:ci": "ng test --watch=false",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "lint": "npm run typecheck"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@types/node": "24.13.3",
    "jsdom": "27.1.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@angular/build": {
      "vite": "8.3.5"
    }
  }
}
