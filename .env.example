# Copy this file as .env before using Docker Compose.
# These values are examples for local development only. Never reuse them in a
# shared, staging or production environment.

COMPOSE_PROJECT_NAME=ruta-fija-local

POSTGRES_DB=ruta_fija
POSTGRES_USER=ruta_fija_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LOCAL_PASSWORD
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=4200

# Required by the backend: random value of at least 32 bytes, encoded as Base64.
JWT_SECRET_BASE64=REPLACE_WITH_BASE64_SECRET_MINIMUM_32_BYTES

# Required only for local demo users loaded by dev; use at least 12 characters.
DEMO_USER_PASSWORD=REPLACE_WITH_A_LOCAL_DEMO_PASSWORD

# Comma-separated origins. Keep this restricted to the local CRM during Phase 1.
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
